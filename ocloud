#!/usr/bin/env bash

# ==============================================================================
# Ocloud CLI - Personal Cloud & Storage Manager for Omarchy Linux
# Resolves Node runtime (including mise shims and installs) seamlessly
# ==============================================================================

if ! command -v node >/dev/null 2>&1; then
  if [ -d "$HOME/.local/share/mise/shims" ]; then
    export PATH="$HOME/.local/share/mise/shims:$PATH"
  fi
  if ! command -v node >/dev/null 2>&1; then
    NODE_BIN="$(find "$HOME/.local/share/mise/installs/node" -name node -type f -perm -111 2>/dev/null | sort -V | tail -n 1)"
    if [ -n "$NODE_BIN" ]; then
      NODE_DIR="$(dirname "$NODE_BIN")"
      export PATH="$NODE_DIR:$PATH"
    fi
  fi
fi

# Ensure ~/.local/bin is in PATH
export PATH="$HOME/.local/bin:$PATH"

if ! command -v node >/dev/null 2>&1; then
  echo "Error: Node.js runtime not found in PATH or ~/.local/share/mise." >&2
  exit 1
fi

# Resolve canonical script directory even if invoked through symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

exec node "$SCRIPT_DIR/cli/index.js" "$@"
