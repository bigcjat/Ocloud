#!/usr/bin/env node
/**
 * Ocloud CLI - The Sovereign Cloud Companion for Omarchy & Linux.
 * Architecture:
 * - Security: AES-256-GCM encrypted credentials vault (~/.config/omarchy/vault.enc).
 * - Pluggable Providers: Hetzner Cloud, Storage Box, Custom Bare-Metal, Home Workstations.
 * - Latency Prober: Live TCP handshake ping test sorted from lowest to highest latency.
 * - Ephemeral Safeguards: Clear data-loss warning on ephemeral VM root mounting.
 * - Automated Backups: Snapshot engine with history and scheduling.
 */

const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const { execSync, spawn } = require('node:child_process');

const { Vault } = require('./security/vault');
const { probeLocations } = require('./ping/prober');
const { HetznerCloudProvider, HetznerStorageBoxProvider } = require('./providers/hetzner');
const { CustomComputeProvider, CustomStorageProvider } = require('./providers/custom');
const { BackupEngine } = require('./backup/engine');

// Initialize Core Subsystems
const vault = new Vault();
const hetznerCloud = new HetznerCloudProvider(vault);
const hetznerStorage = new HetznerStorageBoxProvider(vault);
const customCompute = new CustomComputeProvider(vault);
const customStorage = new CustomStorageProvider(vault);
const backupEngine = new BackupEngine(vault);

// ------------------------------------------------------------------ Formatting Utilities
function formatBytes(bytes) {
  const b = Number(bytes);
  if (isNaN(b) || b <= 0) return '0 B';
  const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
  let val = b;
  for (const u of units) {
    if (val < 1024 || u === 'PB') return `${val.toFixed(1)} ${u}`;
    val /= 1024;
  }
  return `${b} B`;
}

function isDriveMounted(mountPoint) {
  try {
    const out = execSync('mount', { encoding: 'utf8' });
    return out.includes(mountPoint);
  } catch (e) {
    return false;
  }
}

