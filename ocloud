#!/usr/bin/env python3
"""Main CLI for Hetzner Cloud & Storage Companion (hetz)."""

import argparse
import json
import os
import shutil
import subprocess
import sys
from typing import Any, Dict, List, Optional

from hetz_client import HetznerClient, HetznerCloudError
from hetz_config import get_config_path, load_config, save_config
from storage_box import StorageBoxManager


def format_bytes(b: int) -> str:
    if b <= 0:
        return "0 B"
    units = ["B", "KB", "MB", "GB", "TB", "PB"]
    val = float(b)
    for u in units:
        if val < 1024.0 or u == "PB":
            return f"{val:.1f} {u}"
        val /= 1024.0
    return f"{b} B"


def get_full_status(config: Dict[str, Any], mock: bool = False) -> Dict[str, Any]:
    token = config.get("api_token", "")
    client = HetznerClient(token, mock=mock)
    sb_mgr = StorageBoxManager(config, mock=mock)

    storage_status = sb_mgr.get_storage_status()

    servers = []
    active_count = 0
    primary_server = None

    if token or mock:
        try:
            raw_servers = client.list_servers()
            for s in raw_servers:
                st = s.get("status", "unknown")
                if st == "running":
                    active_count += 1
                server_info = {
                    "id": s.get("id"),
                    "name": s.get("name"),
                    "status": st,
                    "type": s.get("server_type", {}).get("name"),
                    "ipv4": s.get("public_net", {}).get("ipv4", {}).get("ip"),
                    "location": s.get("datacenter", {}).get("location", {}).get("name"),
                }
                servers.append(server_info)
            if servers:
                primary_server = servers[0]
        except Exception:
            servers = []

    return {
        "storage": storage_status,
        "compute": {
            "active_count": active_count,
            "total_count": len(servers),
            "primary_server": primary_server,
            "servers": servers,
        },
        "mock": mock,
    }


def cmd_status(args: argparse.Namespace, config: Dict[str, Any]) -> None:
    status = get_full_status(config, mock=args.mock)
    if args.json:
        print(json.dumps(status, indent=2))
        return

    st = status["storage"]
    cmp = status["compute"]

    print("\n\033[1;36m☁  Hetzner Cloud & Storage Companion\033[0m")
    print("━" * 50)

    print("\033[1mStorage Box:\033[0m")
    if st.get("configured"):
        used = format_bytes(st.get("used_bytes", 0))
        total = format_bytes(st.get("total_bytes", 0))
        pct = st.get("used_percent", 0.0)
        mounted = "\033[32mMounted\033[0m" if st.get("mounted") else "\033[33mNot Mounted\033[0m"
        print(f"  • Usage:    {used} / {total} ({pct}%)")
        print(f"  • Status:   {mounted} at {st.get('mount_point')}")
        last_b = st.get("last_backup")
        if last_b:
            print(f"  • Backup:   Last snapshot at {last_b.get('timestamp')}")
    else:
        print("  • \033[33mNot configured\033[0m in ~/.config/omarchy/hetzner.json")

    print("\n\033[1mCloud Compute (VMs):\033[0m")
    if cmp.get("total_count", 0) > 0:
        print(f"  • Active:   {cmp.get('active_count')}/{cmp.get('total_count')} running")
        for s in cmp.get("servers", []):
            st_color = "\033[32m● RUNNING\033[0m" if s["status"] == "running" else f"\033[31m○ {s['status'].upper()}\033[0m"
            print(f"  • {s['name']} ({s['type']}, {s['location']}) {st_color} - {s.get('ipv4', 'no IP')}")
    else:
        print("  • No active servers found in this project.")
    print("━" * 50 + "\n")


def cmd_vm(args: argparse.Namespace, config: Dict[str, Any]) -> None:
    client = HetznerClient(config.get("api_token", ""), mock=args.mock)
    action = args.vm_action

    if action == "list":
        servers = client.list_servers()
        if not servers:
            print("No servers found.")
            return
        print(f"{'ID':<12} {'NAME':<20} {'STATUS':<12} {'TYPE':<8} {'IPV4':<16} {'LOCATION'}")
        print("-" * 75)
        for s in servers:
            ip = s.get("public_net", {}).get("ipv4", {}).get("ip", "-")
            loc = s.get("datacenter", {}).get("location", {}).get("name", "-")
            print(f"{s.get('id'):<12} {s.get('name'):<20} {s.get('status'):<12} {s.get('server_type', {}).get('name'):<8} {ip:<16} {loc}")

    elif action == "create":
        name = args.name
        srv_type = args.type or config.get("default_vm_type", "cx23")
        loc = args.location or config.get("default_location", "nbg1")
        img = args.image or "ubuntu-24.04"
        ts_key = getattr(args, "tailscale_key", None) or config.get("tailscale_auth_key", "")
        user_data = None
        if ts_key:
            user_data = (
                "#!/bin/bash\n"
                "curl -fsSL https://tailscale.com/install.sh | sh\n"
                f"tailscale up --authkey={ts_key} --hostname={name}\n"
            )
            print(f"Tailscale auto-join enabled for hostname: {name}")

        print(f"Creating server '{name}' ({srv_type} in {loc})...")
        res = client.create_server(
            name=name,
            server_type=srv_type,
            location=loc,
            image=img,
            ssh_keys=["omarchy-laptop"],
            user_data=user_data,
        )
        print(f"Server created! ID: {res.get('id', 'unknown')}, Status: {res.get('status', 'initializing')}")

    elif action == "tailscale":
        target = args.target
        ts_key = getattr(args, "key", None) or config.get("tailscale_auth_key", "")
        if not ts_key:
            print("Error: No Tailscale auth key provided. Provide via --key or in ~/.config/omarchy/hetzner.json")
            sys.exit(1)
        s = client.get_server(target)
        if not s:
            print(f"Error: Server '{target}' not found.")
            sys.exit(1)
        ip = s.get("public_net", {}).get("ipv4", {}).get("ip")
        if not ip:
            print("Error: Server has no public IPv4.")
            sys.exit(1)

        print(f"Installing and connecting Tailscale on {s.get('name')} ({ip})...")
        remote_cmd = f"curl -fsSL https://tailscale.com/install.sh | sh && tailscale up --authkey={ts_key} --hostname={s.get('name')}"
        subprocess.run(["ssh", "-i", os.path.expanduser("~/.ssh/id_ed25519"), "-o", "StrictHostKeyChecking=no", f"root@{ip}", remote_cmd], check=True)
        print(f"Tailscale successfully activated on {s.get('name')}!")

    elif action in ("start", "stop", "reboot", "delete"):
        target = args.target
        s = client.get_server(target)
        if not s:
            print(f"Error: Server '{target}' not found.")
            sys.exit(1)
        sid = s["id"]
        if action == "start":
            print(f"Powering on {s['name']} (ID {sid})...")
            client.power_on(sid)
            print("Action initiated.")
        elif action == "stop":
            print(f"Powering off {s['name']} (ID {sid})...")
            client.power_off(sid)
            print("Action initiated.")
        elif action == "reboot":
            print(f"Rebooting {s['name']} (ID {sid})...")
            client.reboot(sid)
            print("Action initiated.")
        elif action == "delete":
            confirm = input(f"Are you sure you want to delete server '{s['name']}' ({sid})? [y/N]: ")
            if confirm.lower() == "y":
                client.delete_server(sid)
                print("Server deleted.")

    elif action == "ssh":
        target = args.target
        s = client.get_server(target)
        if not s:
            print(f"Error: Server '{target}' not found.")
            sys.exit(1)
        ip = s.get("public_net", {}).get("ipv4", {}).get("ip")
        if not ip:
            print("Error: Server has no public IPv4.")
            sys.exit(1)
        print(f"Connecting to root@{ip}...")
        os.execvp("ssh", ["ssh", "-i", os.path.expanduser("~/.ssh/id_ed25519"), "-o", "StrictHostKeyChecking=no", f"root@{ip}"])

    elif action == "inspect":
        target = args.target
        s = client.get_server(target)
        if not s:
            print(f"Error: Server '{target}' not found.")
            sys.exit(1)
        ip = s.get("public_net", {}).get("ipv4", {}).get("ip")
        if not ip:
            print("Error: Server has no public IPv4.")
            sys.exit(1)

        remote_cmd = (
            "echo '---CPU---' && cat /proc/loadavg && "
            "echo '---MEM---' && free -b && "
            "echo '---DISK---' && df -B1 / && "
            "echo '---UPTIME---' && uptime -p && "
            "echo '---PROCS---' && ps -eo pid,%cpu,%mem,comm --sort=-%cpu | head -n 6"
        )
        try:
            res = subprocess.run(
                ["ssh", "-i", os.path.expanduser("~/.ssh/id_ed25519"), "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5", f"root@{ip}", remote_cmd],
                capture_output=True,
                text=True,
                check=True,
            )
            raw = res.stdout
        except Exception as e:
            print(f"Failed to inspect server: {e}")
            sys.exit(1)

        # Parse sections
        data: Dict[str, Any] = {"server": s.get("name"), "ip": ip, "status": s.get("status")}
        current_section = None
        section_lines: Dict[str, List[str]] = {}
        for line in raw.splitlines():
            line_str = line.strip()
            if line_str.startswith("---") and line_str.endswith("---"):
                current_section = line_str.strip("-")
                section_lines[current_section] = []
            elif current_section and line_str:
                section_lines[current_section].append(line_str)

        if "CPU" in section_lines and section_lines["CPU"]:
            load_parts = section_lines["CPU"][0].split()
            if len(load_parts) >= 3:
                data["load_1m"] = float(load_parts[0])
                data["load_5m"] = float(load_parts[1])
                data["load_15m"] = float(load_parts[2])

        if "MEM" in section_lines and len(section_lines["MEM"]) >= 2:
            mem_parts = section_lines["MEM"][1].split()
            data["ram_total"] = int(mem_parts[1])
            data["ram_used"] = int(mem_parts[2])
            data["ram_percent"] = round((data["ram_used"] / data["ram_total"]) * 100, 1)

        if "DISK" in section_lines and len(section_lines["DISK"]) >= 2:
            disk_parts = section_lines["DISK"][1].split()
            data["disk_total"] = int(disk_parts[1])
            data["disk_used"] = int(disk_parts[2])
            data["disk_percent"] = round((data["disk_used"] / data["disk_total"]) * 100, 1)

        if "UPTIME" in section_lines and section_lines["UPTIME"]:
            data["uptime"] = section_lines["UPTIME"][0]

        top_procs = []
        if "PROCS" in section_lines:
            for pline in section_lines["PROCS"][1:]:
                pcs = pline.split()
                if len(pcs) >= 4:
                    top_procs.append({"pid": pcs[0], "cpu": pcs[1], "mem": pcs[2], "cmd": pcs[3]})
        data["top_processes"] = top_procs

        if getattr(args, "json", False):
            print(json.dumps(data, indent=2))
            return

        print(f"\n\033[1;36m⚡ Resource Inspection: {s.get('name')} ({ip})\033[0m")
        print("━" * 50)
        print(f"  • Uptime:     {data.get('uptime', 'unknown')}")
        print(f"  • Load Avg:   {data.get('load_1m', 0.0)} (1m), {data.get('load_5m', 0.0)} (5m)")
        print(f"  • RAM:        {format_bytes(data.get('ram_used', 0))} / {format_bytes(data.get('ram_total', 0))} ({data.get('ram_percent', 0)}%)")
        print(f"  • NVMe Disk:  {format_bytes(data.get('disk_used', 0))} / {format_bytes(data.get('disk_total', 0))} ({data.get('disk_percent', 0)}%)")
        print("\n\033[1mActive Top Processes:\033[0m")
        print(f"  {'PID':<8} {'%CPU':<8} {'%MEM':<8} {'COMMAND'}")
        for pr in top_procs:
            print(f"  {pr['pid']:<8} {pr['cpu']:<8} {pr['mem']:<8} {pr['cmd']}")
        print("━" * 50 + "\n")

    elif action == "app":
        target = args.target
        app_cmd = args.app_command
        s = client.get_server(target)
        if not s:
            print(f"Error: Server '{target}' not found.")
            sys.exit(1)
        ip = s.get("public_net", {}).get("ipv4", {}).get("ip")
        if not ip:
            print("Error: Server has no public IPv4.")
            sys.exit(1)

        print(f"Launching remote native app '{app_cmd}' on {s.get('name')} ({ip})...")
        key_path = os.path.expanduser("~/.ssh/id_ed25519")

        # Prefer waypipe if on Wayland / Omarchy
        if shutil.which("waypipe"):
            print("Using Waypipe (native Wayland window forwarding)...")
            os.execvp("waypipe", ["waypipe", "ssh", "-i", key_path, "-o", "StrictHostKeyChecking=no", f"root@{ip}", app_cmd])
        else:
            print("Using SSH X11 forwarding (-Y)...")
            os.execvp("ssh", ["ssh", "-Y", "-i", key_path, "-o", "StrictHostKeyChecking=no", f"root@{ip}", app_cmd])


def cmd_storage(args: argparse.Namespace, config: Dict[str, Any]) -> None:
    mgr = StorageBoxManager(config, mock=args.mock)
    action = args.storage_action

    if action == "status":
        st = mgr.get_storage_status()
        print(json.dumps(st, indent=2))
    elif action == "mount":
        res = mgr.mount()
        print(res.get("message", res.get("status")))
    elif action == "unmount":
        res = mgr.unmount()
        print(res.get("message", res.get("status")))


def cmd_backup(args: argparse.Namespace, config: Dict[str, Any]) -> None:
    mgr = StorageBoxManager(config, mock=args.mock)
    action = args.backup_action

    if action == "run":
        print("Starting backup to Hetzner Storage Box...")
        res = mgr.run_backup()
        print(res.get("message", res.get("status")))
    elif action == "status":
        info = mgr.get_last_backup_info()
        print(json.dumps(info or {"status": "no backups yet"}, indent=2))


def main() -> None:
    parser = argparse.ArgumentParser(description="Hetzner Cloud & Storage Companion")
    parser.add_argument("--mock", action="store_true", help="Use simulated mock data without live credentials")
    subparsers = parser.add_subparsers(dest="command")

    # status
    p_status = subparsers.add_parser("status", help="Get overview status of Storage Box and VMs")
    p_status.add_argument("--json", action="store_true", help="Output raw JSON for Omarchy shell bar")

    # vm
    p_vm = subparsers.add_parser("vm", help="Manage Hetzner Cloud VMs")
    vm_sub = p_vm.add_subparsers(dest="vm_action", required=True)

    vm_sub.add_parser("list", help="List all cloud servers")

    p_vm_create = vm_sub.add_parser("create", help="Create a new cloud server")
    p_vm_create.add_argument("name", help="Server name")
    p_vm_create.add_argument("--type", default="cx23", help="Server type (default: cx23)")
    p_vm_create.add_argument("--location", default="nbg1", help="Datacenter location (default: nbg1)")
    p_vm_create.add_argument("--image", default="ubuntu-24.04", help="OS Image (default: ubuntu-24.04)")
    p_vm_create.add_argument("--tailscale-key", help="Tailscale Auth Key (e.g. tskey-auth-...)")

    p_vm_ts = vm_sub.add_parser("tailscale", help="Connect an existing server to Tailscale")
    p_vm_ts.add_argument("target", help="Server ID or name")
    p_vm_ts.add_argument("--key", help="Tailscale Auth Key (optional if set in config)")

    for act in ("start", "stop", "reboot", "delete", "ssh"):
        p_act = vm_sub.add_parser(act, help=f"{act.capitalize()} a server")
        p_act.add_argument("target", help="Server ID or name")

    p_inspect = vm_sub.add_parser("inspect", help="Inspect live CPU/RAM/Disk and running processes on a server")
    p_inspect.add_argument("target", help="Server ID or name")
    p_inspect.add_argument("--json", action="store_true", help="Output raw JSON")

    p_app = vm_sub.add_parser("app", help="Launch a remote app with native window forwarding")
    p_app.add_argument("target", help="Server ID or name")
    p_app.add_argument("app_command", help="Command to run on server (e.g. xeyes, devilutionx)")

    # storage
    p_storage = subparsers.add_parser("storage", help="Manage Hetzner Storage Box")
    st_sub = p_storage.add_subparsers(dest="storage_action", required=True)
    st_sub.add_parser("status", help="Storage Box status and quota")
    st_sub.add_parser("mount", help="Mount Storage Box to ~/Cloud")
    st_sub.add_parser("unmount", help="Unmount Storage Box")

    # backup
    p_backup = subparsers.add_parser("backup", help="Manage automated backups")
    bk_sub = p_backup.add_subparsers(dest="backup_action", required=True)
    bk_sub.add_parser("run", help="Run incremental backup now")
    bk_sub.add_parser("status", help="Show last backup info")

    args = parser.parse_args()
    config = load_config()

    if not args.command or args.command == "status":
        cmd_status(args, config)
    elif args.command == "vm":
        cmd_vm(args, config)
    elif args.command == "storage":
        cmd_storage(args, config)
    elif args.command == "backup":
        cmd_backup(args, config)


if __name__ == "__main__":
    main()
