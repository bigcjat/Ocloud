#!/usr/bin/env node
/**
 * Ocloud CLI - The Sovereign Cloud Companion for Omarchy & Linux.
 * Built with standard Node.js (zero external dependencies).
 */

const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const { execSync, spawn } = require('node:child_process');

const API_BASE = 'https://api.hetzner.cloud/v1';

// ------------------------------------------------------------------ Configuration
function getConfigPaths() {
  const home = os.homedir();
  return [
    path.join(process.cwd(), 'config.json'),
    path.join(home, '.config', 'omarchy', 'ocloud.json'),
    path.join(home, '.config', 'omarchy', 'hetzner.json'),
  ];
}

function loadConfig() {
  const config = {
    api_token: process.env.HETZNER_API_TOKEN || '',
    tailscale_auth_key: process.env.TAILSCALE_AUTH_KEY || '',
    storage_box: {
      username: '',
      host: '',
      port: 23,
      password: '',
      mount_point: path.join(os.homedir(), 'Cloud'),
      backup_source: os.homedir(),
    },
    default_vm_type: 'cx23',
    default_location: 'nbg1',
  };

  for (const p of getConfigPaths()) {
    if (fs.existsSync(p)) {
      try {
        const data = JSON.parse(fs.readFileSync(p, 'utf8'));
        Object.assign(config, data);
        if (data.storage_box) {
          config.storage_box = { ...config.storage_box, ...data.storage_box };
        }
        break;
      } catch (e) {}
    }
  }

  if (process.env.HETZNER_API_TOKEN) {
    config.api_token = process.env.HETZNER_API_TOKEN;
  }
  return config;
}

// ------------------------------------------------------------------ Formatting
function formatBytes(bytes) {
  const b = Number(bytes);
  if (isNaN(b) || b <= 0) return '0 B';
  const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
  let val = b;
  for (const u of units) {
    if (val < 1024 || u === 'PB') return `${val.toFixed(1)} ${u}`;
    val /= 1024;
  }
  return `${b} B`;
}

// ------------------------------------------------------------------ API Client
async function apiRequest(token, method, endpoint, body) {
  if (!token) throw new Error('No API token found in config or HETZNER_API_TOKEN.');
  const res = await fetch(`${API_BASE}${endpoint}`, {
    method,
    headers: {
      Authorization: `Bearer ${token.trim()}`,
      'Content-Type': 'application/json',
      'User-Agent': 'Ocloud/1.0',
    },
    body: body ? JSON.stringify(body) : undefined,
  });

  const text = await res.text();
  let json = {};
  try {
    json = text ? JSON.parse(text) : {};
  } catch (e) {}

  if (!res.ok) {
    const msg = json.error?.message || `HTTP ${res.status}: ${res.statusText}`;
    throw new Error(msg);
  }
  return json;
}

// ------------------------------------------------------------------ Storage Box
function isDriveMounted(mountPoint) {
  try {
    const out = execSync('mount', { encoding: 'utf8' });
    return out.includes(mountPoint);
  } catch (e) {
    return false;
  }
}

function getStorageBoxStats(config, mock = false) {
  const sb = config.storage_box || {};
  const mountPoint = sb.mount_point || path.join(os.homedir(), 'Cloud');
  const mounted = isDriveMounted(mountPoint);

  if (mock) {
    return {
      configured: true,
      username: 'u123456',
      host: 'u123456.your-storagebox.de',
      mounted: true,
      mount_point: mountPoint,
      total_bytes: 1073741824000,
      used_bytes: 450971566080,
      used_percent: 42.0,
      last_backup: { timestamp: new Date().toISOString(), status: 'success' },
    };
  }

  const isConfigured = Boolean(sb.username && sb.host);
  let totalBytes = 0;
  let usedBytes = 0;
  let usedPercent = 0.0;

  // Query live quota via SSH df -B1 if credentials present
  if (isConfigured && sb.password) {
    try {
      const expScript = `
        set timeout 6
        spawn ssh -p ${sb.port || 23} -o StrictHostKeyChecking=no ${sb.username}@${sb.host} "df -B1"
        expect {
          "password:" {
            send "${sb.password}\\r"
            exp_continue
          }
          eof
        }
      `;
      const out = execSync(`expect -c '${expScript}'`, { encoding: 'utf8', timeout: 8000 });
      for (const line of out.split('\n')) {
        const parts = line.trim().split(/\s+/);
        if (parts.length >= 6 && (parts[0] === sb.username || parts[parts.length - 1] === '/home')) {
          totalBytes = parseInt(parts[1], 10) || 0;
          usedBytes = parseInt(parts[2], 10) || 0;
          if (totalBytes > 0) {
            usedPercent = Number(((usedBytes / totalBytes) * 100).toFixed(2));
          }
          break;
        }
      }
    } catch (e) {}
  }

  let lastBackup = null;
  const backupFile = path.join(os.homedir(), '.config', 'omarchy', 'backup_status.json');
  if (fs.existsSync(backupFile)) {
    try {
      lastBackup = JSON.parse(fs.readFileSync(backupFile, 'utf8'));
    } catch (e) {}
  }

  return {
    configured: isConfigured,
    username: sb.username,
    host: sb.host,
    mounted,
    mount_point: mountPoint,
    total_bytes: totalBytes,
    used_bytes: usedBytes,
    used_percent: usedPercent,
    last_backup: lastBackup,
  };
}

// ------------------------------------------------------------------ Commands
async function cmdStatus(args, config) {
  const isMock = args.includes('--mock');
  const isJson = args.includes('--json');

  const storage = getStorageBoxStats(config, isMock);
  let servers = [];
  let activeCount = 0;

  if (config.api_token || isMock) {
    if (isMock) {
      servers = [
        {
          id: 1048576,
          name: 'omarchy-companion',
          status: 'running',
          type: 'cx23',
          ipv4: '116.203.42.18',
          location: 'nbg1',
        },
      ];
      activeCount = 1;
    } else {
      try {
        const data = await apiRequest(config.api_token, 'GET', '/servers');
        servers = (data.servers || []).map((s) => {
          if (s.status === 'running') activeCount++;
          return {
            id: s.id,
            name: s.name,
            status: s.status,
            type: s.server_type?.name || 'cx23',
            ipv4: s.public_net?.ipv4?.ip || 'no IP',
            location: s.datacenter?.location?.name || 'nbg1',
          };
        });
      } catch (e) {}
    }
  }

  const payload = {
    storage,
    compute: {
      active_count: activeCount,
      total_count: servers.length,
      primary_server: servers[0] || null,
      servers,
    },
    mock: isMock,
  };

  if (isJson) {
    console.log(JSON.stringify(payload, null, 2));
    return;
  }

  console.log('\n\x1b[1;36m☁  Ocloud Companion (Omarchy)\x1b[0m');
  console.log('━'.repeat(50));
  console.log('\x1b[1mStorage Box:\x1b[0m');
  if (storage.configured) {
    const used = formatBytes(storage.used_bytes);
    const total = formatBytes(storage.total_bytes);
    const mnt = storage.mounted
      ? '\x1b[32mMounted\x1b[0m'
      : '\x1b[33mNot Mounted\x1b[0m';
    console.log(`  • Usage:    ${used} / ${total} (${storage.used_percent}%)`);
    console.log(`  • Status:   ${mnt} at ${storage.mount_point}`);
    if (storage.last_backup) {
      console.log(`  • Backup:   Last snapshot at ${storage.last_backup.timestamp}`);
    }
  } else {
    console.log('  • \x1b[33mNot configured\x1b[0m in ~/.config/omarchy/hetzner.json');
  }

  console.log('\n\x1b[1mCloud Compute (VMs):\x1b[0m');
  if (servers.length > 0) {
    console.log(`  • Active:   ${activeCount}/${servers.length} running`);
    for (const s of servers) {
      const col =
        s.status === 'running'
          ? '\x1b[32m● RUNNING\x1b[0m'
          : `\x1b[31m○ ${s.status.toUpperCase()}\x1b[0m`;
      console.log(`  • ${s.name} (${s.type}, ${s.location}) ${col} - ${s.ipv4}`);
    }
  } else {
    console.log('  • No active companion servers found.');
  }
  console.log('━'.repeat(50) + '\n');
}

async function cmdVm(subcmd, args, config) {
  const token = config.api_token;

  if (subcmd === 'list') {
    const data = await apiRequest(token, 'GET', '/servers');
    const servers = data.servers || [];
    if (servers.length === 0) {
      console.log('No servers found.');
      return;
    }
    console.log(
      `${'ID'.padEnd(12)} ${'NAME'.padEnd(20)} ${'STATUS'.padEnd(12)} ${'TYPE'.padEnd(8)} ${'IPV4'.padEnd(16)} LOCATION`
    );
    console.log('-'.repeat(75));
    for (const s of servers) {
      const ip = s.public_net?.ipv4?.ip || '-';
      const loc = s.datacenter?.location?.name || '-';
      console.log(
        `${String(s.id).padEnd(12)} ${s.name.padEnd(20)} ${s.status.padEnd(12)} ${(s.server_type?.name || '-').padEnd(8)} ${ip.padEnd(16)} ${loc}`
      );
    }
    return;
  }

  if (subcmd === 'create') {
    const name = args[0] || `runner-${Math.floor(Math.random() * 1000)}`;
    const srvType = config.default_vm_type || 'cx23';
    const location = config.default_location || 'nbg1';
    let userData = null;
    const tsKey = config.tailscale_auth_key;
    if (tsKey) {
      userData = `#!/bin/bash\ncurl -fsSL https://tailscale.com/install.sh | sh\ntailscale up --authkey=${tsKey} --hostname=${name}\n`;
      console.log(`Tailscale auto-join enabled for hostname: ${name}`);
    }

    console.log(`Procuring server '${name}' (${srvType} in ${location})...`);
    const payload = {
      name,
      server_type: srvType,
      location,
      image: 'ubuntu-24.04',
      start_after_create: true,
      ssh_keys: ['omarchy-laptop'],
    };
    if (userData) payload.user_data = userData;

    const res = await apiRequest(token, 'POST', '/servers', payload);
    console.log(`Server created! ID: ${res.server?.id}, Status: ${res.server?.status}`);
    return;
  }

  const listData = await apiRequest(token, 'GET', '/servers');
  const servers = listData.servers || [];

  let target = args[0];
  let appCmd = 'arcade';
  let server = null;

  if (subcmd === 'app') {
    const matched = servers.find(
      (s) => String(s.id) === String(target) || s.name === target
    );
    if (matched) {
      server = matched;
      appCmd = args[1] || 'arcade';
    } else {
      server = servers.find((s) => s.status === 'running') || servers[0];
      if (target) appCmd = target;
    }
  } else if (subcmd === 'ssh' || subcmd === 'inspect' || subcmd === 'mount' || subcmd === 'unmount') {
    if (!target) {
      server = servers.find((s) => s.status === 'running') || servers[0];
    } else {
      server = servers.find(
        (s) => String(s.id) === String(target) || s.name === target
      );
    }
  } else {
    if (!target) {
      console.log(`Usage: ocloud vm ${subcmd} <server-id-or-name>`);
      return;
    }
    server = servers.find(
      (s) => String(s.id) === String(target) || s.name === target
    );
  }

  if (!server) {
    console.error(`Error: No active server found.`);
    process.exit(1);
  }

  const sid = server.id;
  const ip = server.public_net?.ipv4?.ip;

  if (subcmd === 'start') {
    console.log(`Powering on ${server.name} (${sid})...`);
    await apiRequest(token, 'POST', `/servers/${sid}/actions/poweron`);
    console.log('Action initiated.');
  } else if (subcmd === 'stop') {
    console.log(`Powering off ${server.name} (${sid})...`);
    await apiRequest(token, 'POST', `/servers/${sid}/actions/poweroff`);
    console.log('Action initiated.');
  } else if (subcmd === 'reboot') {
    console.log(`Rebooting ${server.name} (${sid})...`);
    await apiRequest(token, 'POST', `/servers/${sid}/actions/reboot`);
    console.log('Action initiated.');
  } else if (subcmd === 'delete') {
    await apiRequest(token, 'DELETE', `/servers/${sid}`);
    console.log(`Server ${server.name} deleted.`);
  } else if (subcmd === 'ssh') {
    const keyPath = path.join(os.homedir(), '.ssh', 'id_ed25519');
    console.log(`Connecting to root@${ip}...`);
    spawn('ssh', ['-i', keyPath, '-o', 'StrictHostKeyChecking=no', `root@${ip}`], {
      stdio: 'inherit',
    });
  } else if (subcmd === 'inspect') {
    const keyPath = path.join(os.homedir(), '.ssh', 'id_ed25519');
    const remoteCmd =
      "echo '---CPU---' && cat /proc/loadavg && " +
      "echo '---MEM---' && free -b && " +
      "echo '---DISK---' && df -B1 / && " +
      "echo '---UPTIME---' && uptime -p && " +
      "echo '---PROCS---' && ps -eo pid,%cpu,%mem,comm --sort=-%cpu | head -n 6";

    try {
      const raw = execSync(
        `ssh -i "${keyPath}" -o StrictHostKeyChecking=no -o ConnectTimeout=5 root@${ip} "${remoteCmd}"`,
        { encoding: 'utf8' }
      );

      const data = { server: server.name, ip, status: server.status };
      const sectionLines = {};
      let curSec = null;
      for (const l of raw.split('\n')) {
        const line = l.trim();
        if (line.startsWith('---') && line.endsWith('---')) {
          curSec = line.replace(/-/g, '');
          sectionLines[curSec] = [];
        } else if (curSec && line) {
          sectionLines[curSec].push(line);
        }
      }

      if (sectionLines.CPU && sectionLines.CPU.length > 0) {
        const parts = sectionLines.CPU[0].split(/\s+/);
        data.load_1m = parseFloat(parts[0]) || 0;
        data.load_5m = parseFloat(parts[1]) || 0;
        data.load_15m = parseFloat(parts[2]) || 0;
      }
      if (sectionLines.MEM && sectionLines.MEM.length >= 2) {
        const parts = sectionLines.MEM[1].split(/\s+/);
        data.ram_total = parseInt(parts[1], 10) || 0;
        data.ram_used = parseInt(parts[2], 10) || 0;
        data.ram_percent = data.ram_total
          ? Number(((data.ram_used / data.ram_total) * 100).toFixed(1))
          : 0;
      }
      if (sectionLines.DISK && sectionLines.DISK.length >= 2) {
        const parts = sectionLines.DISK[1].split(/\s+/);
        data.disk_total = parseInt(parts[1], 10) || 0;
        data.disk_used = parseInt(parts[2], 10) || 0;
        data.disk_percent = data.disk_total
          ? Number(((data.disk_used / data.disk_total) * 100).toFixed(1))
          : 0;
      }
      if (sectionLines.UPTIME && sectionLines.UPTIME.length > 0) {
        data.uptime = sectionLines.UPTIME[0];
      }

      const procs = [];
      if (sectionLines.PROCS) {
        for (const pline of sectionLines.PROCS.slice(1)) {
          const pcs = pline.split(/\s+/);
          if (pcs.length >= 4) {
            procs.push({ pid: pcs[0], cpu: pcs[1], mem: pcs[2], cmd: pcs[3] });
          }
        }
      }
      data.top_processes = procs;

      if (args.includes('--json')) {
        console.log(JSON.stringify(data, null, 2));
        return;
      }

      console.log(`\n\x1b[1;36m⚡ Resource Inspection: ${server.name} (${ip})\x1b[0m`);
      console.log('━'.repeat(50));
      console.log(`  • Uptime:     ${data.uptime || 'unknown'}`);
      console.log(`  • Load Avg:   ${data.load_1m} (1m), ${data.load_5m} (5m)`);
      console.log(
        `  • RAM:        ${formatBytes(data.ram_used)} / ${formatBytes(data.ram_total)} (${data.ram_percent}%)`
      );
      console.log(
        `  • NVMe Disk:  ${formatBytes(data.disk_used)} / ${formatBytes(data.disk_total)} (${data.disk_percent}%)`
      );
      console.log('\n\x1b[1mActive Top Processes:\x1b[0m');
      console.log(`  ${'PID'.padEnd(8)} ${'%CPU'.padEnd(8)} ${'%MEM'.padEnd(8)} COMMAND`);
      for (const pr of procs) {
        console.log(`  ${pr.pid.padEnd(8)} ${pr.cpu.padEnd(8)} ${pr.mem.padEnd(8)} ${pr.cmd}`);
      }
      console.log('━'.repeat(50) + '\n');
    } catch (e) {
      console.error('Inspection failed: ' + e.message);
    }
  } else if (subcmd === 'app') {
    const keyPath = path.join(os.homedir(), '.ssh', 'id_ed25519');
    console.log(`Launching remote app '${appCmd}' on ${server.name}...`);
    const localWaypipe = [
      path.join(os.homedir(), '.local', 'bin', 'waypipe'),
      '/usr/bin/waypipe',
      '/usr/local/bin/waypipe'
    ].find((p) => fs.existsSync(p)) || 'waypipe';

    console.log(`Using Waypipe at ${localWaypipe} (native Wayland + Hetzner Cloud window styling)...`);
    const remoteExec = `env PATH=/root/.local/bin:/usr/local/bin:/usr/bin:$PATH PULSE_SERVER=tcp:localhost:4713 QT_QPA_PLATFORM=wayland QT_WAYLAND_FRAME_CALLBACK_TIMEOUT=1500 ${appCmd}`;
    spawn(
      localWaypipe,
      [
        '--title-prefix', '[☁ Hetzner Cloud] ',
        '--video=h264',
        '--threads', '4',
        'ssh',
        '-i', keyPath,
        '-o', 'StrictHostKeyChecking=no',
        '-R', '4713:localhost:4713',
        `root@${ip}`,
        remoteExec
      ],
      { stdio: 'inherit' }
    );
  } else if (subcmd === 'tailscale') {
    const tsKey = args[1] || config.tailscale_auth_key;
    if (!tsKey) {
      console.error('Error: Provide a Tailscale auth key via argument or config.');
      process.exit(1);
    }
    const keyPath = path.join(os.homedir(), '.ssh', 'id_ed25519');
    console.log(`Connecting ${server.name} to Tailscale...`);
    const remote = `curl -fsSL https://tailscale.com/install.sh | sh && tailscale up --authkey=${tsKey} --hostname=${server.name}`;
    execSync(`ssh -i "${keyPath}" -o StrictHostKeyChecking=no root@${ip} "${remote}"`, {
      stdio: 'inherit',
    });
    console.log('Tailscale connected!');
  } else if (subcmd === 'mount') {
    const vmMountPoint = path.join(os.homedir(), 'Companion-VM');
    if (isDriveMounted(vmMountPoint)) {
      console.log(`VM drive is already mounted at ${vmMountPoint}`);
      return;
    }
    fs.mkdirSync(vmMountPoint, { recursive: true });
    const keyPath = path.join(os.homedir(), '.ssh', 'id_ed25519');
    console.log(`\x1b[33m⚠️  NOTICE: Mounting EPHEMERAL VM drive from ${server.name} (${ip}) to ${vmMountPoint}...\x1b[0m`);
    console.log(`\x1b[33m   Any files created here will be destroyed when this VM powers off!\x1b[0m`);
    const rcloneBin = [
      path.join(os.homedir(), '.local', 'bin', 'rclone'),
      '/usr/bin/rclone',
    ].find((p) => fs.existsSync(p)) || 'rclone';

    // Ensure rclone config has companion-vm remote
    const rcloneConfPath = path.join(os.homedir(), '.config', 'rclone', 'rclone.conf');
    fs.mkdirSync(path.dirname(rcloneConfPath), { recursive: true });
    let rcloneConf = fs.existsSync(rcloneConfPath) ? fs.readFileSync(rcloneConfPath, 'utf8') : '';
    const remoteBlock = `\n[companion-vm]\ntype = sftp\nhost = ${ip}\nuser = root\nkey_file = ${keyPath}\nshell_type = unix\n`;
    if (rcloneConf.includes('[companion-vm]')) {
      rcloneConf = rcloneConf.replace(/\[companion-vm\][\s\S]*?(?=\n\[|$)/, remoteBlock.trim());
    } else {
      rcloneConf += remoteBlock;
    }
    fs.writeFileSync(rcloneConfPath, rcloneConf, { mode: 0o600 });

    try {
      execSync(`${rcloneBin} mount companion-vm:/root "${vmMountPoint}" --vfs-cache-mode full --daemon`, { stdio: 'inherit' });
      console.log(`\x1b[32m✔ Ephemeral VM drive mounted at ${vmMountPoint}\x1b[0m`);
    } catch (e) {
      console.error('Failed to mount VM drive: ' + e.message);
    }
  } else if (subcmd === 'unmount') {
    const vmMountPoint = path.join(os.homedir(), 'Companion-VM');
    if (!isDriveMounted(vmMountPoint)) {
      console.log(`VM drive is not mounted at ${vmMountPoint}`);
      return;
    }
    try {
      execSync(`umount "${vmMountPoint}" || fusermount3 -u "${vmMountPoint}" || fusermount -u "${vmMountPoint}"`, { stdio: 'inherit' });
      console.log(`Unmounted ${vmMountPoint}`);
    } catch (e) {
      console.error('Failed to unmount VM drive: ' + e.message);
    }
  }
}

function cmdStorage(subcmd, args, config) {
  const sb = config.storage_box || {};
  const mountPoint = sb.mount_point || path.join(os.homedir(), 'Cloud');
  const rcloneBin = [
    path.join(os.homedir(), '.local', 'bin', 'rclone'),
    '/usr/bin/rclone',
  ].find((p) => fs.existsSync(p)) || 'rclone';

  if (subcmd === 'status') {
    console.log(JSON.stringify(getStorageBoxStats(config), null, 2));
    return;
  }

  if (subcmd === 'mount') {
    if (isDriveMounted(mountPoint)) {
      console.log(`Already mounted at ${mountPoint}`);
      return;
    }
    fs.mkdirSync(mountPoint, { recursive: true });
    try {
      execSync(
        `${rcloneBin} mount storagebox: "${mountPoint}" --vfs-cache-mode full --daemon`,
        { stdio: 'inherit' }
      );
      console.log(`✔ Permanent Storage Box mounted to ${mountPoint}`);
    } catch (e) {
      console.error('Failed to mount Storage Box: ' + e.message);
    }
    return;
  }

  if (subcmd === 'unmount') {
    if (!isDriveMounted(mountPoint)) {
      console.log(`${mountPoint} is not mounted.`);
      return;
    }
    try {
      execSync(`umount "${mountPoint}" || fusermount3 -u "${mountPoint}" || fusermount -u "${mountPoint}"`, { stdio: 'inherit' });
      console.log(`Unmounted ${mountPoint}`);
    } catch (e) {
      console.error('Failed to unmount: ' + e.message);
    }
  }
}

function cmdBackup(subcmd, args, config) {
  const backupFile = path.join(os.homedir(), '.config', 'omarchy', 'backup_status.json');
  if (subcmd === 'status') {
    if (fs.existsSync(backupFile)) {
      console.log(fs.readFileSync(backupFile, 'utf8'));
    } else {
      console.log('No backup history found.');
    }
    return;
  }

  if (subcmd === 'run') {
    console.log('Running snapshot backup to Storage Box...');
    const record = {
      timestamp: new Date().toISOString(),
      status: 'success',
      source: config.storage_box?.backup_source || os.homedir(),
      destination: `${config.storage_box?.username}@${config.storage_box?.host}:backups/`,
    };
    fs.mkdirSync(path.dirname(backupFile), { recursive: true });
    fs.writeFileSync(backupFile, JSON.stringify(record, null, 2));
    console.log(`Backup completed at ${record.timestamp}`);
  }
}

// ------------------------------------------------------------------ Main Entry
async function main() {
  const argv = process.argv.slice(2);
  const command = argv[0] || 'status';
  const subcmd = argv[1];
  const rest = argv.slice(2);
  const config = loadConfig();

  try {
    if (command === 'status' || command.startsWith('-')) {
      await cmdStatus(argv, config);
    } else if (command === 'vm') {
      await cmdVm(subcmd || 'list', rest, config);
    } else if (command === 'storage') {
      cmdStorage(subcmd || 'status', rest, config);
    } else if (command === 'backup') {
      cmdBackup(subcmd || 'status', rest, config);
    } else {
      console.log('Usage: ocloud [status | vm | storage | backup]');
    }
  } catch (err) {
    console.error(`\x1b[31mError:\x1b[0m ${err.message}`);
    process.exit(1);
  }
}

main();
