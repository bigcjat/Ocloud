  "instructions": {
    "navBreadcrumb": "Cloudflare Dashboard › R2 Object Storage › Manage API Tokens",
    "step1": "Log in to your Cloudflare Dashboard and navigate to the R2 section.",
    "step2": "Click 'Create API Token' and select 'Object Read & Write' permission.",
    "step3": "Copy your Account ID, Access Key ID, and Secret Access Key into Ocloud."
  },
  "fields": [
    {
      "key": "endpoint",
      "label": "S3 Endpoint URL (or Account ID)",
      "placeholder": "https://<account-id>.r2.cloudflarestorage.com",
      "helper": "Copy your Account ID from the right sidebar of R2, or paste your S3 API URL",
      "type": "text"
    },
    {
      "key": "bucket",
      "label": "Bucket Name",
      "placeholder": "e.g. ocloud-storage",
      "helper": "The specific R2 bucket to mount into your filesystem",
      "type": "text"
    },
    {
      "key": "access_key",
      "label": "Access Key ID",
      "placeholder": "32-character hexadecimal key",
      "helper": "Generated during R2 API Token creation",
      "type": "text"
    },
    {
      "key": "secret_key",
      "label": "Secret Access Key",
      "placeholder": "64-character secret hash",
      "helper": "Secret value shown only once upon token generation",
      "type": "password"
    }
  ],
  "allowedDomains": [
    "*.r2.cloudflarestorage.com",
    "dash.cloudflare.com"
  ],
  "permissions": {
    "network": true,
    "rclone": true
  },
  "icon": "icons/cloudflare_r2.svg"
}
