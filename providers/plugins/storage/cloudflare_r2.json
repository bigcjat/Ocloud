{
  "id": "cloudflare_r2",
  "name": "Cloudflare R2",
  "type": "storage",
  "category": "cloud",
  "authType": "s3",
  "rcloneType": "s3",
  "defaultRemoteName": "r2",
  "defaultMount": "~/R2",
  "badge": "Zero Egress Fees",
  "badgeColor": "#f38020",
  "brandColor": "#f38020",
  "tagline": "High-speed S3 object store with 10GB free tier and $0 bandwidth fees.",
  "dashboardUrl": "https://dash.cloudflare.com/?to=/:account/r2/api-tokens",
