{
  "id": "storj",
  "name": "Storj DCS",
  "type": "storage",
  "category": "cloud",
  "authType": "s3",
  "rcloneType": "s3",
  "defaultRemoteName": "storj",
  "defaultMount": "~/Storj",
  "badge": "25 GB Free · E2EE",
  "badgeColor": "#2683ff",
  "brandColor": "#2683ff",
  "tagline": "Decentralized, end-to-end encrypted S3 storage with 25GB free tier and zero egress fees.",
  "dashboardUrl": "https://identity.storjshare.io",
  "endpointPlaceholder": "https://gateway.storjshare.io",
  "iconSvg": "<svg fill=\"none\" stroke=\"#ffffff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\n  xmlns=\"http://www.w3.org/2000/svg\"\n  width=\"24\"\n  height=\"24\"\n  viewBox=\"0 0 24 24\"\n  \n  \n  stroke-width=\"2\"\n  stroke-linecap=\"round\"\n  stroke-linejoin=\"round\"\n>\n  <path d=\"M3 17a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\" />\n  <path d=\"M3 7a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\" />\n  <path d=\"M19 17a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\" />\n  <path d=\"M19 7a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\" />\n  <path d=\"M11 3a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\" />\n  <path d=\"M11 21a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\" />\n  <path d=\"M12 21l-8 -4v-10l8 -4l8 4v10l-8 4\" />\n  <path d=\"M9.1 15a2.1 2.1 0 0 1 -.648 -4.098c.282 -1.648 1.319 -2.902 3.048 -2.902c1.694 0 2.906 1.203 3.23 2.8h.17a2.1 2.1 0 0 1 .202 4.19l-.202 .01h-5.8\" />\n  <path d=\"M4 7l4.323 2.702\" />\n  <path d=\"M16.413 14.758l3.587 2.242\" />\n  <path d=\"M4 17l3.529 -2.206\" />\n  <path d=\"M14.609 10.37l5.391 -3.37\" />\n  <path d=\"M12 3v5\" />\n  <path d=\"M12 15v6\" />\n</svg>",
  "instructions": {
    "navBreadcrumb": "Storj Satellite › Access › Create S3 Credentials",
    "step1": "Log in to your Storj Satellite dashboard and go to Access.",
    "step2": "Click 'Create S3 Credentials' with read and write permissions for your bucket.",
    "step3": "Enter your Bucket Name, Access Key ID, and Secret Access Key into Ocloud."
  },
  "fields": [
    {
      "key": "endpoint",
      "label": "Storj Gateway Endpoint",
      "placeholder": "https://gateway.storjshare.io",
      "default": "https://gateway.storjshare.io",
      "helper": "Official Storj S3 Gateway: https://gateway.storjshare.io",
      "type": "text"
    },
    {
      "key": "bucket",
      "label": "Storj Bucket Name",
      "placeholder": "e.g. my-storj-bucket",
      "helper": "The specific Storj bucket to mount into your filesystem",
      "type": "text"
    },
    {
      "key": "key",
      "label": "Access Key ID",
      "placeholder": "Paste Storj S3 Access Key ID",
      "helper": "Generated in Storj Satellite under Access › S3 Credentials",
      "type": "text"
    },
    {
      "key": "secret",
      "label": "Secret Access Key",
      "placeholder": "Paste Storj S3 Secret Access Key",
      "helper": "Secret key shown only once upon S3 credential generation",
      "type": "password"
    }
  ],
  "allowedDomains": [
    "*.storjshare.io",
    "storj.io"
  ],
  "permissions": {
    "network": true,
    "rclone": true
