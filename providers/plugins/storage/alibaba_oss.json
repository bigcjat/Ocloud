{
  "id": "alibaba_oss",
  "name": "Alibaba Cloud OSS",
  "type": "storage",
  "category": "cloud",
  "authType": "s3",
  "rcloneType": "s3",
  "defaultRemoteName": "oss",
  "defaultMount": "~/Alibaba-OSS",
  "badge": "Enterprise OSS",
  "badgeColor": "#FF6A00",
  "brandColor": "#FF6A00",
  "tagline": "Massive, secure, and cost-effective cloud object storage by Alibaba Cloud.",
  "dashboardUrl": "https://oss.console.aliyun.com",
  "iconSvg": "<svg fill=\"#ffffff\" role=\"img\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><title>Alibaba Cloud</title><path d=\"M3.996 4.517h5.291L8.01 6.324 4.153 7.506a1.668 1.668 0 0 0-1.165 1.601v5.786a1.668 1.668 0 0 0 1.165 1.6l3.857 1.183 1.277 1.807H3.996A3.996 3.996 0 0 1 0 15.487V8.513a3.996 3.996 0 0 1 3.996-3.996m16.008 0h-5.291l1.277 1.807 3.857 1.182c.715.227 1.17.889 1.165 1.601v5.786a1.668 1.668 0 0 1-1.165 1.6l-3.857 1.183-1.277 1.807h5.291A3.996 3.996 0 0 0 24 15.487V8.513a3.996 3.996 0 0 0-3.996-3.996m-4.007 8.345H8.002v-1.804h7.995Z\"/></svg>",
  "instructions": {
    "navBreadcrumb": "Alibaba Cloud Console › RAM › Users › Create AccessKey",
    "step1": "Log into Alibaba Cloud Console and open Resource Access Management (RAM).",
    "step2": "Create an AccessKey pair for your user and grant AliyunOSSFullAccess permissions.",
    "step3": "Enter your regional endpoint (e.g. https://oss-us-west-1.aliyuncs.com) and bucket name."
  },
  "fields": [
    {
      "key": "endpoint",
      "label": "OSS Endpoint URL",
      "placeholder": "https://oss-us-west-1.aliyuncs.com",
      "default": "https://oss-us-west-1.aliyuncs.com",
      "type": "text",
      "required": true,
      "helper": "Regional OSS endpoint URL (e.g. https://oss-us-west-1.aliyuncs.com, https://oss-eu-central-1.aliyuncs.com)"
    },
    {
      "key": "bucket",
      "label": "OSS Bucket Name (Optional)",
      "placeholder": "my-oss-bucket",
      "type": "text",
      "required": false,
      "helper": "Target OSS bucket name (leave empty to mount all buckets)"
    },
    {
      "key": "key",
      "label": "AccessKey ID",
      "placeholder": "LTAI...",
      "type": "text",
      "required": true,
      "helper": "Created in Alibaba RAM Console"
    },
    {
      "key": "secret",
      "label": "AccessKey Secret",
      "placeholder": "Paste AccessKey Secret",
      "type": "password",
      "required": true,
      "helper": "Created in Alibaba RAM Console"
    }
  ],
  "allowedDomains": [
    "*.aliyuncs.com",
    "*.alibabacloud.com"
  ],
  "permissions": {
    "network": true,
    "rclone": true
  },
  "icon": "icons/alibaba_oss.svg"
}
