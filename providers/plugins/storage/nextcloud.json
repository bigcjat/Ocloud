{
  "id": "nextcloud",
  "name": "Nextcloud / WebDAV",
  "type": "storage",
  "category": "personal",
  "authType": "webdav",
  "rcloneType": "webdav",
  "defaultRemoteName": "nextcloud",
  "defaultMount": "~/Nextcloud",
  "badge": "Self-Hosted",
  "badgeColor": "#0082c9",
  "brandColor": "#0082c9",
  "tagline": "Connect your self-hosted Nextcloud, ownCloud, or standard WebDAV share.",
  "dashboardUrl": "",
  "iconSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path fill=\"#0082c9\" d=\"M12 5.5A6.5 6.5 0 0 0 5.5 12a6.5 6.5 0 0 0 6.5 6.5 6.5 6.5 0 0 0 6.5-6.5A6.5 6.5 0 0 0 12 5.5m0 10.833A4.333 4.333 0 1 1 16.333 12 4.34 4.34 0 0 1 12 16.333M2.75 8.75A3.25 3.25 0 1 0 6 12a3.254 3.254 0 0 0-3.25-3.25m0 4.875A1.625 1.625 0 1 1 4.375 12a1.627 1.627 0 0 1-1.625 1.625m18.5-4.875A3.25 3.25 0 1 0 24.5 12a3.254 3.254 0 0 0-3.25-3.25m0 4.875A1.625 1.625 0 1 1 22.875 12a1.627 1.627 0 0 1-1.625 1.625\"/></svg>",
  "instructions": {
    "step1": "Click 'Sign In' to configure your Nextcloud server URL and login credentials.",
    "step2": "Enter your server WebDAV endpoint (e.g. https://cloud.example.com/remote.php/dav/files/USER/).",
    "step3": "Authenticate via App Password or standard WebDAV login."
  },
  "allowedDomains": [
    "{{server_url}}"
  ],
  "permissions": {
    "network": true,
    "rclone": true
  }
}
