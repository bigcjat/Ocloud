{
  "id": "scaleway_s3",
  "name": "Scaleway Object Storage",
  "type": "storage",
  "category": "cloud",
  "authType": "s3",
  "rcloneType": "s3",
  "defaultRemoteName": "scaleway",
  "defaultMount": "~/Scaleway",
  "badge": "European S3",
  "badgeColor": "#4F0599",
  "brandColor": "#4F0599",
  "tagline": "European sovereign S3-compatible object storage with multi-datacenter resilience.",
  "dashboardUrl": "https://console.scaleway.com/project/credentials",
  "iconSvg": "<svg role=\"img\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><title>Scaleway</title><path d=\"M16.605 11.11v5.72a1.77 1.77 0 01-1.54 1.69h-4a1.43 1.43 0 01-1.31-1.22 1.09 1.09 0 010-.18 1.37 1.37 0 011.37-1.36h1.74a1 1 0 001-1v-3.62a1.4 1.4 0 011.18-1.39h.17a1.37 1.37 0 011.39 1.36zm-6.46 1.74V9.26a1 1 0 011-1h1.85a1.37 1.37 0 001.37-1.37 1 1 0 000-.17 1.45 1.45 0 00-1.41-1.2h-3.96a1.81 1.81 0 00-1.58 1.66v5.7a1.37 1.37 0 001.37 1.37h.21a1.4 1.4 0 001.15-1.4zm12-4.29V20a4.53 4.53 0 01-4.15 4h-7.58a8.57 8.57 0 01-8.56-8.57V4.54A4.54 4.54 0 016.395 0h7.18a8.56 8.56 0 018.56 8.56zm-2.74 0a5.83 5.83 0 00-5.82-5.82h-7.19a1.79 1.79 0 00-1.8 1.8v10.89a5.83 5.83 0 005.82 5.8h7.44a1.79 1.79 0 001.54-1.48z\"/></svg>",
  "instructions": {
    "navBreadcrumb": "Scaleway Console › Project Settings › IAM / API Keys › Generate API Key",
    "step1": "Open Scaleway Console at https://console.scaleway.com and navigate to IAM or API Keys.",
    "step2": "Generate a new API Key with Object Storage permissions and copy your Secret Key.",
    "step3": "Enter your regional endpoint (e.g. https://s3.fr-par.scw.cloud) and bucket name."
  },
  "fields": [
    {
      "key": "endpoint",
      "label": "Scaleway S3 Endpoint URL",
      "placeholder": "https://s3.fr-par.scw.cloud",
      "default": "https://s3.fr-par.scw.cloud",
      "type": "text",
      "required": true,
      "helper": "Regional endpoint (e.g. https://s3.fr-par.scw.cloud, https://s3.nl-ams.scw.cloud)"
    },
    {
      "key": "bucket",
      "label": "Bucket Name (Optional)",
      "placeholder": "my-scaleway-bucket",
      "type": "text",
      "required": false,
      "helper": "Target bucket name (leave empty to mount all buckets)"
    },
    {
      "key": "key",
      "label": "API Access Key",
      "placeholder": "SCW...",
      "type": "text",
      "required": true,
      "helper": "API Key generated in Scaleway Console"
    },
    {
      "key": "secret",
      "label": "API Secret Key",
      "placeholder": "Paste API Secret Key",
      "type": "password",
      "required": true,
      "helper": "API Secret Key generated in Scaleway Console"
    }
  ],
  "allowedDomains": [
    "*.scw.cloud",
    "*.scaleway.com"
  ],
  "permissions": {
    "network": true,
    "rclone": true
  },
  "icon": "icons/scaleway.svg"
}
