{
  "id": "digitalocean_spaces",
  "name": "DigitalOcean Spaces",
  "type": "storage",
  "category": "cloud",
  "authType": "s3",
  "rcloneType": "s3",
  "defaultRemoteName": "spaces",
  "defaultMount": "~/Spaces",
  "badge": "S3 + CDN",
  "badgeColor": "#0080FF",
  "brandColor": "#0080FF",
  "tagline": "Scalable S3-compatible object storage with built-in CDN for developers.",
  "dashboardUrl": "https://cloud.digitalocean.com/spaces",
  "iconSvg": "<svg role=\"img\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><title>DigitalOcean</title><path d=\"M12.04 0C5.408-.02.005 5.37.005 11.992h4.638c0-4.923 4.882-8.731 10.064-6.855a6.95 6.95 0 014.147 4.148c1.889 5.177-1.924 10.055-6.84 10.064v-4.61H7.391v4.623h4.61V24c7.86 0 13.967-7.588 11.397-15.83-1.115-3.59-3.985-6.446-7.575-7.575A12.8 12.8 0 0012.039 0zM7.39 19.362H3.828v3.564H7.39zm-3.563 0v-2.978H.85v2.978z\"/></svg>",
  "instructions": {
    "navBreadcrumb": "DigitalOcean Cloud › API › Spaces Keys › Generate New Key",
    "step1": "Open DigitalOcean Cloud Console at https://cloud.digitalocean.com/spaces and go to API / Spaces Keys.",
    "step2": "Generate a new Spaces Access Key and copy the Secret Key immediately.",
    "step3": "Enter your region endpoint (e.g. https://nyc3.digitaloceanspaces.com) and Spaces bucket name."
  },
  "fields": [
    {
      "key": "endpoint",
      "label": "Spaces Endpoint URL",
      "placeholder": "https://nyc3.digitaloceanspaces.com",
      "default": "https://nyc3.digitaloceanspaces.com",
      "type": "text",
      "required": true,
      "helper": "Datacenter endpoint (e.g. https://nyc3.digitaloceanspaces.com, https://ams3.digitaloceanspaces.com)"
    },
    {
      "key": "bucket",
      "label": "Spaces Bucket Name (Optional)",
      "placeholder": "my-space-name",
      "type": "text",
      "required": false,
      "helper": "Target bucket name (leave empty to mount all buckets)"
    },
    {
      "key": "key",
      "label": "Spaces Access Key",
      "placeholder": "Paste Spaces Key",
      "type": "text",
      "required": true,
      "helper": "Created under API > Spaces Keys"
    },
    {
      "key": "secret",
      "label": "Spaces Secret Key",
      "placeholder": "Paste Spaces Secret",
      "type": "password",
      "required": true,
      "helper": "Created under API > Spaces Keys"
    }
  ],
  "allowedDomains": [
    "*.digitaloceanspaces.com",
    "*.digitalocean.com"
  ],
  "permissions": {
    "network": true,
    "rclone": true
  },
  "icon": "icons/digitalocean.svg"
}
