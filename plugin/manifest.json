{
  "schemaVersion": 1,
  "id": "community.ocloud",
  "name": "Ocloud",
  "version": "1.0.0",
  "author": "Chris Thompson",
  "license": "MIT",
  "description": "Cloud storage and on-demand cloud compute companion for Omarchy",
  "kinds": ["bar-widget"],
  "activation": "always",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Ocloud",
    "description": "Cloud storage capacity and cloud VM status indicator with quick actions.",
    "category": "Cloud",
    "aliases": ["ocloud", "cloud-storage", "cloud-compute"],
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 60,
      "ocloudBinPath": "ocloud"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "ocloudBinPath",
        "type": "string",
        "label": "Path to ocloud CLI binary",
        "defaultValue": "ocloud"
      }
    ]
  }
}
